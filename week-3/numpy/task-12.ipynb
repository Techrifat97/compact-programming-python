   "source": [
    "import numpy as np\n",
    "\n",
    "array = np.array([\n",
    "    [5, 2, 8],\n",
    "    [1, 9, 3],\n",
    "    [7, 4, 6],\n",
    "    [2, 1, 5]\n",
    "])\n",
    "\n",
    "print(\"Original array:\")\n",
    "print(array)\n",
    "\n",
    "n = 1\n",
    "\n",
    "sorted_array = array[array[:, n].argsort()]\n",
    "\n",
    "print(\"\\nSorted by column\", n)\n",
    "print(sorted_array)"
   ]
  }
 ],
