   ],
   "source": [
    "import numpy as np\n",
    "\n",
    "today = np.datetime64(\"today\")\n",
    "yesterday = today - np.timedelta64(1, \"D\")\n",
    "tomorrow = today + np.timedelta64(1, \"D\")\n",
    "\n",
    "print(\"Yesterday:\", yesterday)\n",
    "print(\"Today:\", today)\n",
    "print(\"Tomorrow:\", tomorrow)"
   ]
  }
 ],
