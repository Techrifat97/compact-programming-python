   "source": [
    "import numpy as np\n",
    "\n",
    "matrix = np.random.random((4, 5))\n",
    "\n",
    "print(\"Original matrix:\")\n",
    "print(matrix)\n",
    "\n",
    "row_means = matrix.mean(axis=1, keepdims=True)\n",
    "\n",
    "result = matrix - row_means\n",
    "\n",
    "print(\"\\nMean of each row:\")\n",
    "print(row_means)\n",
    "\n",
    "print(\"\\nMatrix after subtracting row means:\")\n",
    "print(result)"
   ]
  }
