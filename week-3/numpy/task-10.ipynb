   "source": [
    "import numpy as np\n",
    "\n",
    "points = np.random.random((100, 2))\n",
    "\n",
    "differences = points[:, np.newaxis, :] - points[np.newaxis, :, :]\n",
    "\n",
    "distances = np.sqrt(np.sum(differences ** 2, axis=2))\n",
    "\n",
    "print(\"Coordinates:\") \n",
    "print(points) \n",
    "\n",
    "print(\"\\nPairwise distances:\")\n",
    "print(distances)"
   ]
